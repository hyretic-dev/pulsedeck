# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/app/dist
/tmp
/out-tsc
/bazel-out

# Node
node_modules/
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/app/.angular/cache
.sass-cache/
/connect.lock
/app/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/


# System files
.DS_Store
Thumbs.db

# Environment: environment.ts/environment.prod.ts enthalten keine Secrets (nur die API-Basis) und sind versioniert;
# die für den Mobile-Build erzeugte Datei nicht
app/src/environments/environment.capacitor.ts

# Lokale Compose-Betriebswerte (Secrets) - .env.example ist die Vorlage
.env
backend/dist

# Abzüge der Produktionsdaten (Personendaten, Passwort-Hashes): nie einchecken
backups/

# Archive im Repo-Root (z. B. ein Storage-Export mit Kundendateien): nie einchecken
/*.zip

# Lokale MCP-Konfiguration (Zugänge zu Produktionssystemen): nie einchecken
.mcp.json

# Interne Vertriebs- und Preisplanung (Repo ist öffentlich): nie einchecken
/GO-TO-MARKET.md

# Weitere interne Vertriebsunterlagen (Pipeline, Pitch-Prompt): nie einchecken
/intern/
