{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "heroImage": {
      "type": "string"
    },
    "type": {
      "default": "post",
      "type": "string",
      "enum": [
        "post",
        "template",
        "guide"
      ]
    },
    "seoKeywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "leadMagnetUrl": {
      "type": "string"
    },
    "ctaText": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate"
  ]
}