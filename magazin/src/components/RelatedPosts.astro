---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

interface Props {
  currentSlug: string;
  tags?: string[];
  category?: string;
  relatedIds?: string[];
}

const { currentSlug, tags = [], category, relatedIds = [] } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Calculate related posts score
const scoredPosts = allPosts
  .filter(post => post.id !== currentSlug)
  .map(post => {
    let score = 0;
    
    // 1. Exact match via related_posts array (Highest Priority)
    if (relatedIds.includes(post.id)) {
      score += 100;
    }
    
    // 2. Category match
    if (category && post.data.category === category) {
      score += 2;
    }
    
    // 3. Tags match
    const commonTags = post.data.tags?.filter(tag => tags.includes(tag)) || [];
    score += commonTags.length;

    return { post, score };
  })
  .filter(item => item.score > 0) // Only keep posts with a score
  .sort((a, b) => b.score - a.score) // Sort by highest score first
  .slice(0, 3); // Take top 3
  
const relatedPosts = scoredPosts.map(item => item.post);
---

{relatedPosts.length > 0 && (
  <div class="mt-16 border-t border-border pt-12">
    <h3 class="text-2xl font-bold mb-8 text-text">Ähnliche Artikel</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {relatedPosts.map(post => (
        <a href={`/magazin/blog/${post.id}/`} class="group block no-underline">
          {post.data.heroImage && (
            <div class="aspect-video w-full overflow-hidden rounded-xl mb-4 bg-surface-raised border border-border">
              <Image 
                src={post.data.heroImage} 
                alt={post.data.title} 
                width={600} 
                height={337} 
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" 
              />
            </div>
          )}
          <div class="text-xs font-medium text-linke mb-2 uppercase tracking-wider">
            {post.data.category || post.data.type}
          </div>
          <h4 class="text-lg font-bold text-text group-hover:text-linke transition-colors mb-2 leading-tight">
            {post.data.title}
          </h4>
          <p class="text-text-muted text-sm line-clamp-2 m-0">
            {post.data.summary || post.data.description}
          </p>
        </a>
      ))}
    </div>
  </div>
)}
