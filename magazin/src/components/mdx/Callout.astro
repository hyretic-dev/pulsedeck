---
interface Props {
  type?: 'info' | 'warning' | 'success' | 'danger';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const config = {
  info: {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>',
    classes: 'bg-blue-50/10 border-blue-500/50 text-blue-200'
  },
  warning: {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>',
    classes: 'bg-amber-50/10 border-amber-500/50 text-amber-200'
  },
  success: {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>',
    classes: 'bg-green-50/10 border-green-500/50 text-green-200'
  },
  danger: {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>',
    classes: 'bg-red-50/10 border-red-500/50 text-red-200'
  }
};

const activeConfig = config[type];
---

<div class={`my-8 flex gap-4 rounded-xl border p-6 shadow-sm ${activeConfig.classes}`}>
  <div class="mt-1 shrink-0" set:html={activeConfig.icon} />
  <div class="w-full">
    {title && <h5 class="mb-2 mt-0 font-bold text-inherit">{title}</h5>}
    <div class="prose-p:last-of-type:mb-0 text-inherit text-sm">
      <slot />
    </div>
  </div>
</div>
