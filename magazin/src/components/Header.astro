---
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Extract top categories (by count)
const categoryCounts = allPosts.reduce((acc, post) => {
    if (post.data.category) {
        acc[post.data.category] = (acc[post.data.category] || 0) + 1;
    }
    return acc;
}, {} as Record<string, number>);

// Top 3 Kategorien für das Matrix-Layout
const topCategories = Object.entries(categoryCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3)
    .map(entry => entry[0]);

// Helper for category icons
const getCategoryIcon = (category: string) => {
    const cat = category.toLowerCase();
    if (cat.includes('mitglied')) return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`;
    if (cat.includes('kasse') || cat.includes('finanz')) return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>`;
    if (cat.includes('recht') || cat.includes('dsgvo')) return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`;
    if (cat.includes('marketing') || cat.includes('kommunikation')) return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`;
    if (cat.includes('orga')) return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>`;
    return `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`;
};
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl flex-none transition-colors duration-500 bg-surface/80 border-b border-border shadow-sm">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<nav class="flex items-center justify-between h-24 relative">
			
			<!-- Logo -->
			<div class="flex-shrink-0 flex items-center">
				<a href="/magazin/" class="font-black text-3xl tracking-tighter text-text hover:text-linke transition-colors">
					{SITE_TITLE}
				</a>
			</div>
			
			<!-- Desktop Menu -->
			<div class="hidden md:flex space-x-10 items-center h-full pt-1">
				
				<!-- Mega Menu Dropdown -->
				<div class="group h-full flex items-center relative">
					<button class="font-bold text-lg text-text hover:text-linke transition-colors py-1 flex items-center gap-1.5">
						Themen & Artikel
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-rotate-180 text-text-muted"><path d="m6 9 6 6 6-6"/></svg>
					</button>
					
					<!-- Full Width Dropdown (Category Matrix) -->
					<div class="absolute top-full left-1/2 -translate-x-1/2 w-[1000px] bg-surface-raised border border-border rounded-2xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-3 group-hover:translate-y-0 z-50 overflow-hidden">
						
						<!-- Decorative Top Border -->
						<div class="h-1.5 w-full bg-gradient-to-r from-linke via-violet to-linke"></div>

						<div class="grid grid-cols-4 relative z-10 p-3">
                            
                            <!-- Columns 1-3: Categories and their top posts -->
                            {topCategories.map(cat => {
                                const posts = allPosts
                                    .filter(p => p.data.category === cat)
                                    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
                                    .slice(0, 3);

                                return (
                                    <div class="col-span-1 p-6 md:p-8">
                                        <a href={`/magazin/kategorie/${cat.toLowerCase().replace(/\s+/g, '-')}/`} class="group/catheader block mb-6 pb-4 border-b border-border/50">
                                            <h3 class="text-base font-black text-text uppercase tracking-widest flex items-center gap-2.5 group-hover/catheader:text-linke transition-colors">
                                                <div class="text-linke" set:html={getCategoryIcon(cat)} />
                                                {cat}
                                            </h3>
                                        </a>
                                        <ul class="space-y-5">
                                            {posts.map(post => (
                                                <li>
                                                    <a href={`/magazin/blog/${post.id}/`} class="group/post block hover:-translate-y-0.5 transition-transform">
                                                        <h4 class="font-bold text-base text-text leading-snug group-hover/post:text-linke transition-colors line-clamp-3">{post.data.title}</h4>
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                        {posts.length >= 3 && (
                                            <a href={`/magazin/kategorie/${cat.toLowerCase().replace(/\s+/g, '-')}/`} class="inline-block mt-6 text-sm font-bold text-linke hover:text-linke-light transition-colors">
                                                Alle ansehen &rarr;
                                            </a>
                                        )}
                                    </div>
                                );
                            })}

                            <!-- Column 4: Resources Sidebar -->
                            <div class="col-span-1 p-8 bg-surface rounded-xl border border-border m-3">
                                <h3 class="text-sm font-bold text-text-muted uppercase tracking-widest mb-8 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                                    Ressourcen
                                </h3>
                                <ul class="space-y-5">
                                    <li>
                                        <a href="/magazin/blog/" class="group/res flex items-center gap-3.5 p-2 -mx-2 rounded-xl hover:bg-surface-raised transition-colors border border-transparent hover:border-border">
                                            <div class="w-10 h-10 rounded-lg bg-linke/10 text-linke flex items-center justify-center shrink-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/></svg>
                                            </div>
                                            <div class="font-bold text-base text-text group-hover/res:text-linke transition-colors">Excel-Vorlagen</div>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/magazin/blog/" class="group/res flex items-center gap-3.5 p-2 -mx-2 rounded-xl hover:bg-surface-raised transition-colors border border-transparent hover:border-border">
                                            <div class="w-10 h-10 rounded-lg bg-violet/10 text-violet flex items-center justify-center shrink-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                            </div>
                                            <div class="font-bold text-base text-text group-hover/res:text-violet transition-colors">Checklisten</div>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/magazin/blog/" class="group/res flex items-center gap-3.5 p-2 -mx-2 rounded-xl hover:bg-surface-raised transition-colors border border-transparent hover:border-border">
                                            <div class="w-10 h-10 rounded-lg bg-orange-500/10 text-orange-500 flex items-center justify-center shrink-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                                            </div>
                                            <div class="font-bold text-base text-text group-hover/res:text-orange-500 transition-colors">DSGVO-Hilfe</div>
                                        </a>
                                    </li>
                                </ul>
                            </div>
						</div>
                        
                        <!-- Bottom Bar -->
                        <div class="bg-surface p-5 border-t border-border flex justify-between items-center px-10">
                            <span class="text-sm font-medium text-text-muted">Suchst du nach einem bestimmten Thema?</span>
                            <a href="/magazin/blog/" class="text-sm font-bold text-linke hover:text-linke-light flex items-center gap-1.5">
                                Gesamtes Magazin durchsuchen <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </a>
                        </div>
					</div>
				</div>
				
				<!-- Call to Action Button -->
				<a href="/" class="ml-6 px-8 py-3.5 rounded-xl bg-linke text-white font-bold hover:bg-linke-light transition-all shadow-xl shadow-linke/20 hover:shadow-linke/40 active:scale-95 border-b-0 flex items-center gap-2 text-lg">
					Zum Portal <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			</div>
			
			<!-- Mobile Menu Button -->
			<div class="md:hidden flex items-center">
				<button type="button" class="text-text-muted hover:text-text p-2 transition-colors">
					<svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</div>

		</nav>
	</div>
</header>
