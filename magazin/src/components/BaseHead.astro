---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	seo_title?: string;
	seo_description?: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	last_modified?: Date;
	seoKeywords?: string[];
	author?: string;
	canonical_url?: string;
	draft?: boolean;
}

const { 
	title, 
	description, 
	seo_title,
	seo_description,
	image = FallbackImage, 
	type = 'website',
	pubDate,
	updatedDate,
	last_modified,
	seoKeywords,
	author,
	canonical_url,
	draft = false
} = Astro.props;

// Use SEO overrides if available
const displayTitle = seo_title || title;
const displayDescription = seo_description || description;

// Determine Canonical URL
const currentUrl = new URL(Astro.url.pathname, Astro.site);
const canonicalURL = canonical_url ? new URL(canonical_url) : currentUrl;

const resolvedImage = typeof image === 'string' ? image : image.src;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Robots Tag -->
{draft ? (
	<meta name="robots" content="noindex, nofollow" />
) : (
	<meta name="robots" content="index, follow" />
)}

<!-- Primary Meta Tags -->
<title>{displayTitle}</title>
<meta name="title" content={displayTitle} />
<meta name="description" content={displayDescription} />
{seoKeywords && seoKeywords.length > 0 && (
	<meta name="keywords" content={seoKeywords.join(', ')} />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={displayTitle} />
<meta property="og:description" content={displayDescription} />
<meta property="og:image" content={new URL(resolvedImage, Astro.url)} />
<meta property="og:locale" content="de_DE" />

{type === 'article' && pubDate && (
	<meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === 'article' && (last_modified || updatedDate) && (
	<meta property="article:modified_time" content={(last_modified || updatedDate)?.toISOString()} />
)}
{type === 'article' && author && (
	<meta property="article:author" content={author} />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={displayTitle} />
<meta property="twitter:description" content={displayDescription} />
<meta property="twitter:image" content={new URL(resolvedImage, Astro.url)} />

