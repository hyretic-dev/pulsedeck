---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, type, seoKeywords, leadMagnetUrl, ctaText } = Astro.props;
---

<html lang="de" class="dark">
	<head>
		<BaseHead 
            title={title} 
            description={description} 
            type="article"
            pubDate={pubDate}
            updatedDate={updatedDate}
            seoKeywords={seoKeywords}
            image={heroImage} 
        />
	</head>

	<body class="flex flex-col min-h-screen">
		<Header />
		
		<main class="flex-grow py-12 lg:py-20 relative">
            <!-- Background Decoration -->
            <div class="absolute top-0 right-0 w-[500px] h-[500px] opacity-10 pointer-events-none overflow-hidden">
                <div class="absolute -top-20 -right-20 w-96 h-96 bg-linke rounded-full mix-blend-screen filter blur-3xl"></div>
            </div>

			<article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
				
                <!-- Article Header -->
                <header class="text-center mb-12 animate-fade-in-up">
                    <div class="text-sm font-medium text-linke mb-4 uppercase tracking-wider">
                        {type === 'template' ? 'Vorlagen & Downloads' : type === 'guide' ? 'Ratgeber & Compliance' : 'Magazin'}
                    </div>
                    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-text mb-6 max-w-4xl mx-auto">
                        {title}
                    </h1>
					<div class="flex items-center justify-center gap-4 text-text-muted">
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                            <FormattedDate date={pubDate} />
                        </div>
						{
							updatedDate && (
								<div class="flex items-center gap-2 italic text-sm">
									<span>(Update: <FormattedDate date={updatedDate} />)</span>
								</div>
							)
						}
					</div>
				</header>

                <!-- Hero Image -->
                {heroImage && (
                    <div class="w-full aspect-[2/1] md:aspect-[21/9] rounded-2xl overflow-hidden mb-16 shadow-2xl border border-border animate-fade-in-up" style="animation-delay: 100ms;">
                        <Image width={1020} height={510} src={heroImage} alt={title} class="w-full h-full object-cover" />
                    </div>
                )}

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                    
                    <!-- Main Content -->
                    <div class:list={[
                        "prose prose-invert lg:prose-xl max-w-none animate-fade-in-up",
                        type === 'template' ? 'lg:col-span-8' : 'lg:col-span-12 max-w-4xl mx-auto'
                    ]} style="animation-delay: 200ms;">
                        <slot />

                        <!-- Funnel 2: Guide / Pain-Point (Rendered at the bottom of the article) -->
                        {type === 'guide' && (
                            <div class="mt-16 p-8 rounded-2xl bg-surface-raised border border-linke/30 shadow-lg shadow-linke/5 relative overflow-hidden not-prose">
                                <div class="absolute top-0 left-0 w-2 h-full bg-linke"></div>
                                <h3 class="text-2xl font-bold text-text mb-4 mt-0">DSGVO-Strafen im Verein vermeiden</h3>
                                <p class="text-text-muted mb-6 leading-relaxed">
                                    {ctaText || "Machen Sie sich nicht privat haftbar. Lokale Listen und WhatsApp-Gruppen verstoßen oft gegen geltendes Recht. Mit Pulsedeck digitalisieren Sie Ihren Verein 100% rechts- und DSGVO-konform (Hosted in Germany/EU)."}
                                </p>
                                <a href="/" class="inline-block px-6 py-3 rounded-lg bg-linke text-white font-medium hover:bg-linke-light transition-all shadow-md active:scale-95 no-underline">
                                    Jetzt rechtssicher digitalisieren
                                </a>
                            </div>
                        )}
                    </div>

                    <!-- Funnel 1: Template / Programmatic SEO (Rendered as Sticky Sidebar) -->
                    {type === 'template' && (
                        <div class="lg:col-span-4 animate-fade-in-up" style="animation-delay: 300ms;">
                            <div class="sticky top-24 p-6 rounded-2xl bg-surface-raised border border-border shadow-xl">
                                <div class="flex items-center gap-3 mb-4 text-linke">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M8 13h2"/><path d="M8 17h2"/><path d="M14 13h2"/><path d="M14 17h2"/></svg>
                                    <h3 class="font-bold text-lg text-text m-0">Ihr kostenloser Download</h3>
                                </div>
                                <p class="text-sm text-text-muted mb-6">
                                    Laden Sie sich die Vorlage kostenfrei herunter.
                                </p>
                                <a href={leadMagnetUrl || "#"} class="block w-full text-center px-4 py-3 rounded-lg bg-surface border border-border text-text font-medium hover:bg-surface-raised hover:border-linke transition-all mb-8 shadow-sm">
                                    &#8595; Datei herunterladen
                                </a>

                                <div class="h-px w-full bg-border mb-8"></div>

                                <h4 class="font-bold text-text mb-3">Warnung vor Excel & Word</h4>
                                <p class="text-sm text-text-muted mb-6">
                                    {ctaText || "Lokale Dateien sind fehleranfällig, schwer aktuell zu halten und verstoßen beim Teilen via WhatsApp oder Mail oft gegen den Datenschutz."}
                                </p>
                                <a href="/" class="block w-full text-center px-4 py-3 rounded-lg bg-linke text-white font-medium hover:bg-linke-light transition-all shadow-md hover:shadow-linke/30 active:scale-95">
                                    Besser mit Pulsedeck
                                </a>
                            </div>
                        </div>
                    )}
                </div>
			</article>
		</main>
		<Footer />
	</body>
</html>
