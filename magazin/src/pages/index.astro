---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 3);
---

<!doctype html>
<html lang="de" class="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		
		<main class="flex-grow">
			<!-- Hero Section -->
			<section class="relative py-20 lg:py-32 overflow-hidden">
				<!-- Pulsedeck Blob Animation Background -->
				<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] opacity-20 pointer-events-none">
					<div class="absolute top-10 left-10 w-72 h-72 bg-linke rounded-full mix-blend-screen filter blur-3xl opacity-70 animate-blob"></div>
					<div class="absolute top-0 right-10 w-72 h-72 bg-violet rounded-full mix-blend-screen filter blur-3xl opacity-70 animate-blob" style="animation-delay: 2s;"></div>
					<div class="absolute -bottom-10 left-40 w-72 h-72 bg-teal rounded-full mix-blend-screen filter blur-3xl opacity-70 animate-blob" style="animation-delay: 4s;"></div>
				</div>

				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 animate-fade-in-up">
					<div class="text-center max-w-3xl mx-auto">
						<h1 class="text-5xl md:text-7xl font-bold tracking-tight text-text mb-6">
							Willkommen im <span class="text-linke">Magazin</span>
						</h1>
						<p class="text-xl text-text-muted mb-10 leading-relaxed">
							Entdecke spannende Einblicke, Tutorials und Updates rund um Pulsedeck und moderne Webentwicklung.
						</p>
						<div class="flex flex-col sm:flex-row justify-center gap-4">
							<a href="/magazin/blog" class="px-8 py-3 rounded-lg bg-linke text-white font-medium hover:bg-linke-light transition-all shadow-lg shadow-linke/30 hover:shadow-linke/50 active:scale-95 text-lg">
								Alle Beiträge lesen
							</a>
							<a href="/" class="px-8 py-3 rounded-lg bg-surface border border-border text-text font-medium hover:bg-surface-raised transition-all active:scale-95 text-lg">
								Zum Portal wechseln
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Latest Posts Section -->
			<section class="py-16 bg-surface border-t border-border">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex justify-between items-end mb-10">
						<div>
							<h2 class="text-3xl font-bold text-text">Neueste Beiträge</h2>
							<p class="text-text-muted mt-2">Frisch aus der Redaktion</p>
						</div>
						<a href="/magazin/blog" class="hidden sm:block text-linke hover:text-linke-light font-medium transition-colors">
							Alle anzeigen &rarr;
						</a>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
						{
							posts.map((post) => (
								<a href={`/magazin/blog/${post.id}/`} class="group flex flex-col bg-surface-raised rounded-2xl border border-border overflow-hidden hover:border-linke/50 transition-all hover:shadow-xl hover:shadow-linke/5 hover:-translate-y-1">
									<div class="relative aspect-video w-full overflow-hidden bg-surface">
                                        {post.data.heroImage ? (
                                            <Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                                        ) : (
                                            <div class="w-full h-full bg-surface flex items-center justify-center text-border transition-transform duration-500 group-hover:scale-105">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
                                            </div>
                                        )}
                                        <!-- Badge for Type -->
                                        {post.data.type && (
                                            <div class="absolute top-4 left-4">
                                                <span class={`px-3 py-1 text-xs font-bold rounded-full uppercase tracking-wider backdrop-blur-md ${
                                                    post.data.type === 'template' ? 'bg-linke/90 text-white shadow-lg' : 
                                                    post.data.type === 'guide' ? 'bg-violet/90 text-white shadow-lg' : 
                                                    'bg-surface/80 text-text border border-border'
                                                }`}>
                                                    {post.data.type === 'template' ? 'Vorlage' : post.data.type === 'guide' ? 'Ratgeber' : 'Artikel'}
                                                </span>
                                            </div>
                                        )}
                                    </div>
									<div class="p-6 flex flex-col flex-grow">
                                        <div class="text-sm text-text-muted mb-3 flex items-center gap-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                            <FormattedDate date={post.data.pubDate} />
                                        </div>
										<h3 class="text-xl font-bold text-text group-hover:text-linke transition-colors mb-3 leading-snug">
											{post.data.title}
										</h3>
										<p class="text-text-muted line-clamp-3 text-sm">
											{post.data.description}
										</p>
									</div>
								</a>
							))
						}
					</div>
					
					<div class="mt-10 sm:hidden text-center">
						<a href="/magazin/blog" class="inline-block text-linke hover:text-linke-light font-medium transition-colors">
							Alle anzeigen &rarr;
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
