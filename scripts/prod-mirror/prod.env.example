# Vorlage für backups/.prod.env  (die echte Datei ist git-ignoriert; Rechte 600: chmod 600 backups/.prod.env)
# Zugangsdaten nie im Chat oder in Commits weitergeben – nur hier eintragen.

# Pflicht: lesender Zugang zur Produktionsdatenbank.
# Supabase-Dashboard → Project Settings → Database → Connection string. Direkt (db.<ref>.supabase.co:5432, braucht IPv6 oder das
# IPv4-Add-on) oder „Session pooler“ (Port 5432 des Poolers, IPv4). NICHT der Transaction-Pooler (Port 6543): pg_dump funktioniert dort nicht.
# Besser als die Projektrolle: ein eigenes Lesekonto (CREATE ROLE … LOGIN; GRANT pg_read_all_data TO …).
PROD_DATABASE_URL=postgres://postgres:HIER_PASSWORT@db.<projekt-ref>.supabase.co:5432/postgres?sslmode=require

# Optional (Konfiguration, die nicht in der Datenbank steht: Auth-Einstellungen, Edge-Function-Liste, Secret-Namen)
SUPABASE_PROJECT_REF=<projekt-ref>
SUPABASE_ACCESS_TOKEN=

# Optional (Storage-Spiegel des Buckets files): Dashboard → Project Settings → Storage → S3 Connection
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=

# Optional: Client-Image für psql/pg_dump (Server ≥ 18 → postgres:18)
# PG_CLIENT_IMAGE=pgvector/pgvector:pg17
