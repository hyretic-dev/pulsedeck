{
  "name": "pulsedeck-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').writeFileSync('dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "start": "node dist/main.js",
    "migration:up": "node-pg-migrate -d MIGRATIONS_DATABASE_URL up",
    "migration:down": "node-pg-migrate -d MIGRATIONS_DATABASE_URL down",
    "migration:create": "node-pg-migrate -d MIGRATIONS_DATABASE_URL -j sql create",
    "migrate:export": "node dist/migration/cli.js export",
    "migrate:import": "node dist/migration/cli.js import",
    "migrate:validate": "node dist/migration/cli.js validate"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/mailparser": "3.9.0",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "mailparser": "3.9.38",
    "smtp-server": "3.19.21",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "^6.2.12",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.0.16",
    "pdf-parse": "1.1.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "3.6.7"
  }
}
