---
/** Bildmarke von PulseDeck (Puls-Linie auf roter Kachel); gleiche Form wie favicon.svg. Dekorativ, der Name steht daneben. */
interface Props {
  /** Kantenlänge in Pixeln */
  groesse?: number;
  class?: string;
}
const { groesse = 36, class: klasse = '' } = Astro.props;
const id = `pd-verlauf-${groesse}`;
---

<svg class={klasse} width={groesse} height={groesse} viewBox="0 0 512 512" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff2a2a" />
      <stop offset="1" stop-color="#b80000" />
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="112" fill={`url(#${id})`} />
  <path d="M88 272H176L212 168L268 360L312 216L340 272H424" fill="none" stroke="#fff" stroke-width="44" stroke-linecap="round" stroke-linejoin="round" />
</svg>
