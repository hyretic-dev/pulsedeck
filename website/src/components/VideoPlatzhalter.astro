---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Pfad zum Video unter public/ (z. B. /video/pulsedeck-in-90-sekunden.mp4). Ohne Angabe erscheint der Platzhalter. */
  src?: string;
  /** Vorschaubild (Poster) */
  poster: ImageMetadata;
  titel: string;
  /** Untertitel-Datei (WebVTT) unter public/, für Barrierefreiheit */
  untertitel?: string;
  /** Quellennachweis unter dem Video, z. B. für Musik unter Creative-Commons-Lizenz */
  nachweis?: string;
}
const { src, poster, titel, untertitel, nachweis } = Astro.props;
// Das Video wird selbst gehostet (kein YouTube-Embed): keine Drittanbieter, keine Cookies, CSP bleibt bei 'self'.
---

<figure class="relative rounded-2xl border border-[var(--color-border)] overflow-hidden bg-[var(--color-surface)] shadow-2xl shadow-black/50">
  {
    src ? (
      <>
      <div class="relative">
        <video controls preload="none" playsinline poster={poster.src} width={poster.width} height={poster.height} class="block w-full h-auto" aria-label={titel}>
          <source src={src} type="video/mp4" />
          {untertitel && <track kind="captions" src={untertitel} srclang="de" label="Deutsch" default />}
        </video>
        <button type="button" data-video-play class="group absolute inset-0 flex items-center justify-center cursor-pointer" aria-label={`${titel} abspielen`}>
          <span class="w-20 h-20 rounded-full bg-white/10 backdrop-blur-md border border-white/25 flex items-center justify-center shadow-xl transition-transform group-hover:scale-110 motion-reduce:transition-none" aria-hidden="true">
            <i class="pi pi-play text-cta text-2xl ml-1" />
          </span>
        </button>
      </div>
      {nachweis && <figcaption class="px-4 py-2.5 border-t border-[var(--color-border)] text-xs text-[var(--color-text-muted)]">{nachweis}</figcaption>}
      </>
    ) : (
      <div class="relative">
        <Image src={poster} alt="" widths={[800, 1200]} sizes="(min-width: 1024px) 896px, 100vw" class="block w-full h-auto opacity-40 blur-[2px]" loading="lazy" />
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 text-center px-6">
          <span class="w-16 h-16 rounded-full bg-cta flex items-center justify-center shadow-xl" aria-hidden="true">
            <i class="pi pi-play text-white text-2xl ml-1" />
          </span>
          <figcaption>
            <span class="block font-bold text-lg">{titel}</span>
            <span class="block text-sm text-[var(--color-text-muted)] mt-1">Das Video ist in Arbeit und erscheint hier in Kürze.</span>
          </figcaption>
        </div>
      </div>
    )
  }
</figure>

<!-- Statische Datei statt gebündeltem Inline-Script: die CSP der Website (script-src 'self') blockiert Inline-Scripts. -->
<script is:inline defer src="/js/video-play.js"></script>
