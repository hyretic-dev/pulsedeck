---
const jahr = new Date().getFullYear();
const link = 'text-[var(--color-text-muted)] hover:text-linke transition-colors';
---

<footer class="relative z-10 border-t border-[var(--color-border)] py-12 px-4 bg-[var(--color-surface)]">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-linke/20 flex items-center justify-center">
          <i class="pi pi-users text-linke text-sm" aria-hidden="true"></i>
        </div>
        <span class="font-semibold">PulseDeck</span>
        <span class="text-[var(--color-text-muted)] text-sm">- Mitgliederaktivierung, einfach gemacht.</span>
      </div>
      <nav class="flex items-center gap-6 text-sm" aria-label="Rechtliches und Hilfe">
        <a href="/impressum" class={link}>Impressum</a>
        <a href="/handbuch" class={link}>Handbuch</a>
        <a href="/datenschutz" class={link}>Datenschutz</a>
      </nav>
    </div>
    <div class="flex flex-col items-center gap-4 mt-8 pt-8 border-t border-[var(--color-border)]">
      <div class="text-sm text-[var(--color-text-muted)]">© {jahr} PulseDeck. Mit ❤️ entwickelt für gemeinnützige Organisationen.</div>
    </div>
  </div>
</footer>
