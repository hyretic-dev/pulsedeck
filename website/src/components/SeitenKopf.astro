---
/** Kopfbereich der Unterseiten: Brotkrumen, Kicker, H1 und Einleitung. */
interface Props {
  kicker?: string;
  titel: string;
  text?: string;
  /** Brotkrumen ohne Startseite; der letzte Eintrag ist die aktuelle Seite */
  pfad?: Array<{ name: string; href?: string }>;
}
const { kicker, titel, text, pfad = [] } = Astro.props;
---

<section class="relative overflow-hidden px-4 sm:px-6 pt-12 md:pt-16 pb-12 md:pb-16">
  <div class="hero-licht" aria-hidden="true"></div>
  <div class="relative max-w-4xl mx-auto">
    {
      pfad.length > 0 && (
        <nav aria-label="Brotkrumen" class="text-sm text-[var(--color-text-muted)] mb-6">
          <ol class="flex flex-wrap gap-1.5">
            <li><a href="/" class="hover:text-[var(--color-text)]">Start</a></li>
            {pfad.map((p) => (
              <li class="flex gap-1.5">
                <span aria-hidden="true">/</span>
                {p.href ? <a href={p.href} class="hover:text-[var(--color-text)]">{p.name}</a> : <span aria-current="page">{p.name}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {kicker && <p class="abschnitt-kicker">{kicker}</p>}
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-[1.08] hyphens-auto break-words">{titel}</h1>
    {text && <p class="text-lg md:text-xl text-[var(--color-text-muted)] mt-6 leading-relaxed max-w-3xl">{text}</p>}
    <slot />
  </div>
</section>
