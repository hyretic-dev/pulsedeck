---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import Screenshot from '../components/Screenshot.astro';
import VideoPlatzhalter from '../components/VideoPlatzhalter.astro';
import ProblemVergleich from '../components/ProblemVergleich.astro';
import VertrauensRaster from '../components/VertrauensRaster.astro';
import FaqListe from '../components/FaqListe.astro';
import CtaAbschluss from '../components/CtaAbschluss.astro';
import { APP_URL, KONTAKT, SITE_URL } from '../config';
import { DASHBOARD_BILD, FUNKTIONEN } from '../data/funktionen';
import spotPoster from '../assets/video/pulsedeck-spot-poster.webp';
import { ZIELGRUPPEN } from '../data/zielgruppen';
import { VERTRAUEN_KURZ } from '../data/vertrauen';
import { FAQ_ALLGEMEIN } from '../data/faq';
import { faqSchema, ORG_ID, SOFTWARE_ID, STANDARD_BILD, WEBSITE_ID } from '../seo';

const titel = 'PulseDeck - Vereinsapp für Helferplanung & Mitglieder';
const beschreibung =
  'Die datensichere Vereinsapp aus Deutschland: Termine, Helferschichten, Vereinswiki und Dateien an einem Ort, für Vereine, Ortsverbände und Initiativen.';
const fragen = FAQ_ALLGEMEIN.slice(0, 5);
const jsonLd = [
  {
    '@type': 'SoftwareApplication',
    '@id': SOFTWARE_ID,
    name: 'PulseDeck',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Vereinsorganisation und Helferplanung',
    operatingSystem: 'Web',
    url: `${SITE_URL}/`,
    image: STANDARD_BILD,
    description: beschreibung,
    inLanguage: 'de-DE',
    publisher: { '@id': ORG_ID },
    featureList: FUNKTIONEN.map((f) => f.name),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', description: 'Early Access: alle Funktionen kostenlos' },
  },
  { '@type': 'WebPage', '@id': `${SITE_URL}/#webseite`, url: `${SITE_URL}/`, name: titel, description: beschreibung, isPartOf: { '@id': WEBSITE_ID }, about: { '@id': SOFTWARE_ID }, inLanguage: 'de-DE' },
  faqSchema(`${SITE_URL}/`, fragen),
];
---

<Base title={titel} description={beschreibung} path="/" jsonLd={jsonLd}>
  <SiteHeader />
  <main>
    <!-- Hero: Problem, Zielgruppe, Beleg und Produkt im ersten Bildschirm -->
    <section class="relative overflow-hidden px-4 sm:px-6 pt-16 md:pt-24 pb-16">
      <div class="hero-licht" aria-hidden="true"></div>
      <div class="relative max-w-5xl mx-auto text-center">
        <p class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-raised)] px-3 py-1.5 text-xs font-semibold text-[var(--color-text-muted)]">
          <span class="w-2 h-2 rounded-full bg-green-500" aria-hidden="true"></span> Early Access: alle Funktionen kostenlos
        </p>
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight leading-[1.05] mt-6">
          Schluss mit dem<br /><span class="text-gradient-animated">WhatsApp-Chaos.</span>
        </h1>
        <p class="text-lg md:text-2xl text-[var(--color-text-muted)] mt-6 max-w-3xl mx-auto leading-relaxed">
          Termine, Helferschichten und Vereinswissen an einem Ort, für <strong class="text-[var(--color-text)]">Vereine, Ortsverbände und Initiativen</strong>. Euer Chat bleibt, das Chaos geht.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-3 mt-9">
          <a href={`${APP_URL}/registrieren`} class="btn-primaer text-lg">Jetzt ausprobieren <i class="pi pi-arrow-right" aria-hidden="true"></i></a>
          <a href="#so-funktionierts" class="btn-sekundaer text-lg"><i class="pi pi-play-circle" aria-hidden="true"></i> So funktioniert's</a>
        </div>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-8 text-sm text-[var(--color-text-muted)]" aria-label="Auf einen Blick">
          {VERTRAUEN_KURZ.map((v) => <li class="flex items-center gap-1.5"><i class="pi pi-check text-green-500 text-xs" aria-hidden="true" />{v}</li>)}
        </ul>
      </div>
      <div class="relative max-w-6xl mx-auto mt-14">
        <Screenshot bild={DASHBOARD_BILD} alt="Dashboard von PulseDeck: Begrüßung, Onboarding, offene Helferschichten, Mitglieder- und Terminübersicht" sizes="(min-width: 1200px) 1152px, 100vw" prioritaet />
      </div>
    </section>

    <section id="problem" class="px-4 sm:px-6 py-20 md:py-28 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
      <div class="max-w-6xl mx-auto"><ProblemVergleich /></div>
    </section>

    <section id="so-funktionierts" class="px-4 sm:px-6 py-20 md:py-28 scroll-mt-20">
      <div class="max-w-4xl mx-auto text-center">
        <p class="abschnitt-kicker">So funktioniert's</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Vom Chat-Aufruf zum fertigen Helferplan</h2>
        <p class="text-lg text-[var(--color-text-muted)] mt-4">Termin anlegen, Schichten festlegen, Link teilen: Den Rest erledigen eure Mitglieder selbst.</p>
      </div>
      <div class="max-w-4xl mx-auto mt-10">
        <VideoPlatzhalter
          src="/video/pulsedeck-in-60-sekunden.mp4"
          untertitel="/video/pulsedeck-in-60-sekunden.de.vtt"
          poster={spotPoster}
          titel="PulseDeck in 60 Sekunden"
          nachweis="Musik: „Shiny Tech“ von Kevin MacLeod (incompetech.com), Lizenz Creative Commons BY 4.0. Stimme: KI-generiert."
        />
      </div>
      <ol class="max-w-5xl mx-auto mt-12 grid gap-4 md:grid-cols-3">
        {
          [
            ['Termin anlegen', 'Datum, Ort und auf Wunsch eine Arbeitsgruppe, die den Termin verantwortet.'],
            ['Schichten festlegen', 'Aufgaben mit Uhrzeit und Zahl der Plätze, etwa Aufbau, Grill und Kasse.'],
            ['Link teilen', 'Im Feed, per E-Mail oder in eurer bestehenden Gruppe. Mitglieder tragen sich selbst ein.'],
          ].map(([t, x], i) => (
            <li class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-raised)] p-6">
              <span class="w-8 h-8 rounded-full bg-cta text-white text-sm font-bold flex items-center justify-center" aria-hidden="true">{i + 1}</span>
              <h3 class="font-bold mt-4">{t}</h3>
              <p class="text-sm text-[var(--color-text-muted)] mt-2">{x}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      FUNKTIONEN.map((f, i) => (
        <section id={f.slug} class:list={['px-4 sm:px-6 py-20 md:py-24 scroll-mt-20 border-t border-[var(--color-border)]', i % 2 === 0 ? 'bg-[var(--color-surface)]' : '']}>
          <div class:list={['max-w-6xl mx-auto grid gap-12 items-center', f.hochformat ? 'md:grid-cols-[1.1fr_0.9fr]' : 'lg:grid-cols-[0.85fr_1.15fr]']}>
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              <p class="abschnitt-kicker"><i class={`pi ${f.icon} mr-1.5`} aria-hidden="true" />{f.name}</p>
              <h2 class="text-3xl md:text-4xl font-bold tracking-tight">{f.titel}</h2>
              <p class="text-lg text-[var(--color-text-muted)] mt-5 leading-relaxed">{f.text}</p>
              <ul class="mt-6 space-y-2.5">
                {f.punkte.map((p) => (
                  <li class="flex gap-2.5"><i class="pi pi-check text-green-500 mt-1 text-sm" aria-hidden="true" /><span>{p}</span></li>
                ))}
              </ul>
              <a href={`/funktionen/${f.slug}`} class="inline-flex items-center gap-1.5 mt-7 font-semibold text-akzent hover:underline">
                Mehr zu {f.name} <i class="pi pi-arrow-right text-xs" aria-hidden="true" />
              </a>
            </div>
            <Screenshot bild={f.bild} alt={f.bildAlt} rahmen={f.hochformat ? 'karte' : 'browser'} sizes={f.hochformat ? '(min-width: 768px) 420px, 100vw' : '(min-width: 1024px) 640px, 100vw'} class={f.hochformat ? 'max-w-md mx-auto' : ''} />
          </div>
        </section>
      ))
    }

    <section id="zielgruppen" class="px-4 sm:px-6 py-20 md:py-28 border-t border-[var(--color-border)]">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl">
          <p class="abschnitt-kicker">Für wen</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Für Vereine, Ortsverbände und Initiativen</h2>
          <p class="text-lg text-[var(--color-text-muted)] mt-4">Überall dort, wo Ehrenamtliche Termine stemmen, Aufgaben teilen und Wissen weitergeben.</p>
        </div>
        <ul class="grid gap-4 md:grid-cols-3 mt-10">
          {
            ZIELGRUPPEN.map((z) => (
              <li>
                <a href={`/${z.slug}`} class="block h-full rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-raised)] p-6 hover:border-linke/40 transition-colors">
                  <i class={`pi ${z.icon} text-akzent text-xl`} aria-hidden="true" />
                  <h3 class="text-xl font-bold mt-4">{z.name}</h3>
                  <p class="text-[var(--color-text-muted)] mt-2 text-sm leading-relaxed">{z.intro}</p>
                  <span class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-akzent">PulseDeck für {z.name} <i class="pi pi-arrow-right text-xs" aria-hidden="true" /></span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="vertrauen" class="px-4 sm:px-6 py-20 md:py-28 bg-[var(--color-surface)] border-t border-[var(--color-border)]">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-3xl">
          <p class="abschnitt-kicker">Datenschutz & Sicherheit</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Datenschutz, den ihr eurem Vorstand erklären könnt</h2>
          <p class="text-lg text-[var(--color-text-muted)] mt-4">Keine Versprechen, sondern Fakten, die ihr nachprüfen könnt.</p>
        </div>
        <div class="mt-10"><VertrauensRaster /></div>
        <a href="/sicherheit" class="inline-flex items-center gap-1.5 mt-8 font-semibold text-akzent hover:underline">Alles zu Sicherheit und Datenschutz <i class="pi pi-arrow-right text-xs" aria-hidden="true"></i></a>
      </div>
    </section>

    <section id="abgrenzung" class="px-4 sm:px-6 py-20 md:py-28 border-t border-[var(--color-border)]">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-center">Wofür PulseDeck da ist, und wofür nicht</h2>
        <div class="grid gap-6 md:grid-cols-2 mt-10">
          <div class="rounded-2xl border border-green-500/25 bg-green-500/5 p-7">
            <h3 class="font-bold text-lg">PulseDeck ist für</h3>
            <ul class="mt-4 space-y-2.5">
              {['Termine, Zusagen und Helferschichten', 'Ankündigungen, Umfragen und Newsletter', 'Arbeitsgruppen und ihre Dokumente', 'Vereinswissen, das bleibt'].map((p) => <li class="flex gap-2.5"><i class="pi pi-check text-green-500 mt-1 text-sm" aria-hidden="true" />{p}</li>)}
            </ul>
          </div>
          <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-raised)] p-7">
            <h3 class="font-bold text-lg">Dafür gibt es bessere Werkzeuge</h3>
            <ul class="mt-4 space-y-2.5 text-[var(--color-text-muted)]">
              {['Mitgliedsbeiträge, SEPA und Buchhaltung: eine Vereinsverwaltung', 'Schneller Austausch: euer Messenger', 'Serienbriefe per Post: eure Textverarbeitung'].map((p) => <li class="flex gap-2.5"><i class="pi pi-arrow-right text-xs mt-1.5" aria-hidden="true" />{p}</li>)}
            </ul>
            <a href="/blog/vereinsapp-oder-vereinsverwaltung" class="inline-block mt-5 text-sm font-semibold text-akzent hover:underline">Vereinsapp oder Vereinsverwaltung?</a>
          </div>
        </div>
      </div>
    </section>

    <section id="pilot" class="px-4 sm:px-6 py-20 md:py-28 bg-[var(--color-surface)] border-t border-[var(--color-border)]">
      <div class="max-w-4xl mx-auto text-center">
        <p class="abschnitt-kicker">Early Access</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Werdet Pilot-Organisation</h2>
        <p class="text-lg text-[var(--color-text-muted)] mt-5 leading-relaxed">
          PulseDeck wird gemeinsam mit den ersten Organisationen weiterentwickelt. Als Pilot nutzt ihr alle Funktionen kostenlos, habt einen
          direkten Draht zu den Entwicklern, und was euch fehlt, landet auf der Roadmap.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-3 mt-8">
          <a href={`${APP_URL}/registrieren`} class="btn-primaer">Jetzt ausprobieren</a>
          <a href={`mailto:${KONTAKT}?subject=Pilot-Organisation%20PulseDeck`} class="btn-sekundaer"><i class="pi pi-envelope" aria-hidden="true"></i> Als Pilot melden</a>
        </div>
      </div>
    </section>

    <section class="px-4 sm:px-6 py-20 md:py-28 border-t border-[var(--color-border)]">
      <div class="max-w-3xl mx-auto">
        <FaqListe fragen={fragen} />
        <a href="/faq" class="inline-flex items-center gap-1.5 mt-6 font-semibold text-akzent hover:underline">Alle Fragen <i class="pi pi-arrow-right text-xs" aria-hidden="true"></i></a>
      </div>
    </section>

    <CtaAbschluss />
  </main>
  <Footer />
</Base>
