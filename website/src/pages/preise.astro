---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import SeitenKopf from '../components/SeitenKopf.astro';
import FaqListe from '../components/FaqListe.astro';
import CtaAbschluss from '../components/CtaAbschluss.astro';
import { APP_URL, KONTAKT, SITE_URL } from '../config';
import { FUNKTIONEN } from '../data/funktionen';
import { FAQ_ALLGEMEIN, FAQ_PREISE } from '../data/faq';
import { brotkrumen, faqSchema, SOFTWARE_ID } from '../seo';

const titel = 'Kosten: im Early Access kostenlos - PulseDeck';
const beschreibung =
  'Was PulseDeck kostet: Im Early Access alle Funktionen kostenlos und ohne Mitgliederlimit. Wie es danach weitergeht, ist noch offen.';
const fragen = [FAQ_ALLGEMEIN.find((f) => f.frage === 'Was kostet PulseDeck?')!, ...FAQ_PREISE];
const url = `${SITE_URL}/preise`;
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${url}#webseite`,
    url,
    name: titel,
    description: beschreibung,
    about: { '@id': SOFTWARE_ID },
    inLanguage: 'de-DE',
  },
  {
    '@type': 'Offer',
    '@id': `${url}#early-access`,
    name: 'Early Access',
    price: '0',
    priceCurrency: 'EUR',
    description: 'Alle Funktionen kostenlos, ohne Mitgliederlimit, für die Dauer des Early Access',
    itemOffered: { '@id': SOFTWARE_ID },
    url,
  },
  faqSchema(url, fragen),
  brotkrumen([{ name: 'Kosten', pfad: '/preise' }]),
];
const enthalten = [...FUNKTIONEN.map((f) => f.name), 'Rollen und Rechte', 'Optionaler KI-Assistent', 'Datenexport'];
---

<Base title={titel} description={beschreibung} path="/preise" jsonLd={jsonLd}>
  <SiteHeader aktiv="preise" />
  <main>
    <SeitenKopf
      kicker="Kosten"
      titel="Im Early Access kostenlos. Mit allen Funktionen."
      text="Während des Early Access zahlt ihr nichts, egal wie groß eure Organisation ist. Wie es danach weitergeht, ist noch offen."
      pfad={[{ name: 'Kosten' }]}
    />

    <section class="px-4 sm:px-6 pb-20" aria-label="Tarife">
      <div class="max-w-5xl mx-auto grid gap-6 md:grid-cols-[1.15fr_0.85fr]">
        <article class="rounded-3xl border-2 border-cta/60 bg-[var(--color-surface-raised)] p-8 relative">
          <p class="inline-flex items-center gap-2 rounded-full bg-green-500/10 border border-green-500/30 px-3 py-1 text-xs font-semibold text-green-400">
            <span class="w-2 h-2 rounded-full bg-green-500" aria-hidden="true"></span> Jetzt verfügbar
          </p>
          <h2 class="text-2xl font-bold mt-5">Early Access</h2>
          <p class="mt-3"><span class="text-5xl font-extrabold">0 €</span> <span class="text-[var(--color-text-muted)]">während des Early Access</span></p>
          <p class="text-[var(--color-text-muted)] mt-4">Alle Funktionen, ohne Mitgliederlimit, ohne Kreditkarte.</p>
          <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
            {enthalten.map((p) => <li class="flex gap-2.5"><i class="pi pi-check text-green-500 mt-1 text-sm" aria-hidden="true" />{p}</li>)}
          </ul>
          <a href={`${APP_URL}/registrieren`} class="btn-primaer mt-8 w-full sm:w-auto">Jetzt ausprobieren <i class="pi pi-arrow-right" aria-hidden="true"></i></a>
        </article>

        <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8">
          <p class="inline-flex rounded-full border border-[var(--color-border)] px-3 py-1 text-xs font-semibold text-[var(--color-text-muted)]">Nach dem Early Access</p>
          <h2 class="text-2xl font-bold mt-5">Das ist noch offen</h2>
          <dl class="mt-6 space-y-6">
            <div>
              <dt class="font-semibold">Wie geht es danach weiter?</dt>
              <dd class="text-[var(--color-text-muted)] mt-1">Das wissen wir selbst noch nicht. PulseDeck entsteht gemeinsam mit den ersten Organisationen, und wir wollen erst verstehen, was euch wirklich hilft.</dd>
            </div>
            <div>
              <dt class="font-semibold">Wir sagen es rechtzeitig</dt>
              <dd class="text-[var(--color-text-muted)] mt-1">Bevor sich etwas ändert, informieren wir euch per E-Mail.</dd>
            </div>
            <div>
              <dt class="font-semibold">Eure Daten gehören euch</dt>
              <dd class="text-[var(--color-text-muted)] mt-1">Ihr könnt sie jederzeit exportieren. PulseDeck ist Open Source (AGPLv3).</dd>
            </div>
          </dl>
          <a href={`mailto:${KONTAKT}?subject=Kosten%20PulseDeck`} class="inline-flex items-center gap-1.5 mt-8 font-semibold text-akzent hover:underline"><i class="pi pi-envelope text-sm" aria-hidden="true"></i> Fragen zu den Kosten</a>
        </article>
      </div>
    </section>

    <section class="px-4 sm:px-6 py-20 bg-[var(--color-surface)] border-t border-[var(--color-border)]">
      <div class="max-w-3xl mx-auto"><FaqListe fragen={fragen} titel="Fragen zu Kosten und Early Access" /></div>
    </section>

    <CtaAbschluss />
  </main>
  <Footer />
</Base>
