---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Seite nicht gefunden - PulseDeck" description="Diese Seite gibt es nicht." path="/404" noindex>
  <SiteHeader />
  <main class="max-w-2xl mx-auto px-6 py-24 text-center">
    <h1 class="text-5xl font-extrabold mb-4">404</h1>
    <p class="text-lg text-[var(--color-text-muted)] mb-8">Diese Seite gibt es nicht (mehr).</p>
    <a href="/" class="inline-block px-6 py-3 bg-linke hover:bg-linke-light text-white rounded-lg font-bold transition-all">Zur Startseite</a>
  </main>
  <Footer />
</Base>
