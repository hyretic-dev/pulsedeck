---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL } from '../../config';
import { brotkrumen, WEBSITE_ID } from '../../seo';

const kapitel = (await getCollection('handbook')).sort((a, b) => a.data.order - b.data.order);
const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE_URL}/handbuch#seite`,
    url: `${SITE_URL}/handbuch`,
    name: 'PulseDeck Handbuch',
    inLanguage: 'de-DE',
    isPartOf: { '@id': WEBSITE_ID },
    hasPart: kapitel.map((k) => ({ '@type': 'TechArticle', name: k.data.title, url: `${SITE_URL}/handbuch/${k.id}` })),
  },
  brotkrumen([{ name: 'Handbuch', pfad: '/handbuch' }]),
];
---

<Base
  title="PulseDeck Handbuch: Anleitungen für Mitglieder und Admins"
  description="Anleitungen, Workflows und Hilfe für PulseDeck: von der ersten Anmeldung bis zur Verwaltung deiner Organisation."
  path="/handbuch"
  jsonLd={jsonLd}
>
  <SiteHeader aktiv="handbuch" />
  <main class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-3">Handbuch</h1>
    <p class="text-lg text-[var(--color-text-muted)] mb-12 max-w-2xl">
      Anleitungen, Workflows und Hilfe für PulseDeck - von der ersten Anmeldung bis zur Verwaltung deiner Organisation.
    </p>
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        kapitel.map((k) => (
          <li>
            <a
              href={`/handbuch/${k.id}`}
              class="flex gap-4 h-full p-5 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-raised)] hover:border-linke/40 hover:bg-[var(--color-surface-overlay)] transition-colors"
            >
              <div class="w-11 h-11 rounded-xl bg-linke/10 flex items-center justify-center shrink-0">
                <i class={`pi ${k.data.icon} text-linke`} aria-hidden="true" />
              </div>
              <div>
                <h2 class="font-bold text-lg">{k.data.title}</h2>
                <p class="text-sm text-[var(--color-text-muted)] mt-1 leading-snug">{k.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Base>
