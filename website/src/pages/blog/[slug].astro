---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL } from '../../config';
import { beitraege, datum } from '../../blog';

export async function getStaticPaths() {
  return (await beitraege()).map((eintrag) => ({ params: { slug: eintrag.id }, props: { eintrag } }));
}

const { eintrag } = Astro.props;
const { Content } = await render(eintrag);
const { title, description, date, updated, author, tags } = eintrag.data;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: { '@type': 'Organization', name: 'PulseDeck' },
  keywords: tags.join(', '),
  inLanguage: 'de',
  mainEntityOfPage: `${SITE_URL}/blog/${eintrag.id}`,
};
---

<Base title={`${title} – PulseDeck Blog`} description={description} path={`/blog/${eintrag.id}`} jsonLd={jsonLd}>
  <SiteHeader aktiv="blog" />
  <main class="max-w-3xl mx-auto px-6 py-16">
    <nav class="text-sm text-[var(--color-text-muted)] mb-6" aria-label="Brotkrumen">
      <a href="/blog" class="hover:text-linke">Blog</a> <span aria-hidden="true">/</span> {title}
    </nav>
    <article>
      <header class="mb-10">
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4">{title}</h1>
        <p class="text-sm text-[var(--color-text-muted)]">
          <time datetime={date.toISOString()}>{datum(date)}</time> · {author}
          {updated && <span> · aktualisiert <time datetime={updated.toISOString()}>{datum(updated)}</time></span>}
        </p>
      </header>
      <div class="handbuch prose prose-invert max-w-none">
        <Content />
      </div>
    </article>
    <p class="mt-14 pt-8 border-t border-[var(--color-border)]"><a href="/blog" class="text-linke hover:underline">← Alle Beiträge</a></p>
  </main>
  <Footer />
</Base>
